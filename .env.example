RAWTOH_ISSUER=http://localhost:10000/api/auth
# Hub SPA (sign-in page). Defaults to the issuer origin — same host in production.
RAWTOH_APP_URL=http://localhost:10001

# Sign-in mode. Unset = cookie SSO: this module lives on a subdomain of the hub's
# COOKIE_DOMAIN (localhost in dev) and forwards the hub session cookie to
# GET /api/me. Set both to sign users in with OIDC instead (self-hosted on
# another domain); then RAWTOH_REDIRECT_URI / RAWTOH_SCOPES apply.
# RAWTOH_CLIENT_ID=
# RAWTOH_CLIENT_SECRET=

RAWTOH_REDIRECT_URI=http://localhost:10600/callback
RAWTOH_SCOPES="openid profile email module:install"

RAWTOH_WS_URL=ws://127.0.0.1:10006

APP_URL=http://localhost:10601

SESSION_SECRET=change-me-in-production-please

# REQUIRED in every environment — the API refuses to start without it.
# Encrypts the Ed25519 private keys at rest. There is no plaintext mode.
# 32 random bytes, base64: openssl rand -base64 32
# Distinct from SESSION_SECRET on purpose — rotating one must not orphan the
# other. Rotating this one forces every account to re-enroll.
ENCRYPTION_KEY=

DATABASE_URL=postgres://rawtoh:rawtoh@localhost:10602/twitch

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:10600/callback/twitch

# ── Production ──────────────────────────────────────────────────
# k3s (rawtoh.io): nothing to do here — config lives in
# deploy/k8s/configmap.yaml and deploy/k8s/bootstrap/secrets.example.yaml.
#
# Docker Compose modes (standalone / external proxy) consume only these
# variables — the URLs above (REDIRECT_URI, APP_URL, DATABASE_URL) are
# derived automatically.
#
# PUBLIC_DOMAIN=twitch.example.com       # full public hostname of this module
# POSTGRES_PASSWORD=CHANGE_ME
# SESSION_SECRET=                        # 64+ random chars
# ENCRYPTION_KEY=               # openssl rand -base64 32 (private key encryption at rest)
# RAWTOH_ISSUER=https://app.example.com/api/auth
# RAWTOH_CLIENT_ID=
# RAWTOH_CLIENT_SECRET=
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# DOMAIN=example.com                     # standalone mode only (module served at twitch.<DOMAIN>)
# ACME_EMAIL=                            # standalone mode only (Let's Encrypt)
# PROXY_NETWORK=                         # external-proxy mode only: your existing Docker network
# IMAGE_TAG=production                   # pin production-<sha7> to roll back