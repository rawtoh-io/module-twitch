{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "bun run migrate.ts && bun run src/index.ts",
    "dev": "bun --env-file=../../.env --watch run src/index.ts",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env drizzle-kit migrate",
    "db:push": "bun --env-file=../../.env drizzle-kit push",
    "db:studio": "bun --env-file=../../.env drizzle-kit studio"
  },
  "dependencies": {
    "@hono/session": "^0.2.0",
    "@module-twitch/shared": "workspace:*",
    "@twurple/api": "^8.0.3",
    "@twurple/auth": "^8.0.3",
    "@twurple/chat": "^8.0.3",
    "@twurple/eventsub-ws": "^8.0.3",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.8",
    "openid-client": "^6.8.2",
    "json-rpc-2.0": "^1.7.1",
    "pg": "^8.20.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.0"
  }
}
